{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AETHER Claim proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "campaign_id", "metric", "operator", "threshold", "required_evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "metric": {"type": "string", "minLength": 1},
    "operator": {"enum": ["gte", "lte", "within_absolute_tolerance"]},
    "threshold": {"type": "number"},
    "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
