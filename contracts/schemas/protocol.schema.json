{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AETHER frozen research protocol draft 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveQuantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "seeds",
    "dataset_sha256",
    "evaluator_sha256",
    "policy_version",
    "budget",
    "worker_limits",
    "metric_rules",
    "required_replays",
    "network_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/quantity"
      }
    },
    "dataset_sha256": {
      "$ref": "#/$defs/digest"
    },
    "evaluator_sha256": {
      "$ref": "#/$defs/digest"
    },
    "policy_version": {
      "$ref": "#/$defs/id"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_ms",
        "attempts",
        "model_tokens",
        "paid_cost_micro_usd"
      ],
      "properties": {
        "wall_ms": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "attempts": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "model_tokens": {
          "$ref": "#/$defs/quantity"
        },
        "paid_cost_micro_usd": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "worker_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_threads",
        "memory_bytes",
        "timeout_ms",
        "output_bytes"
      ],
      "properties": {
        "cpu_threads": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "memory_bytes": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "timeout_ms": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "output_bytes": {
          "$ref": "#/$defs/positiveQuantity"
        }
      }
    },
    "metric_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "operator",
          "tolerance"
        ],
        "properties": {
          "metric": {
            "$ref": "#/$defs/id"
          },
          "operator": {
            "const": "gte_baseline_minus"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "required_replays": {
      "$ref": "#/$defs/quantity"
    },
    "network_allowed": {
      "const": false
    }
  }
}
