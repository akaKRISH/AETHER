{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/apo11/quality-evaluation.schema.json",
  "title": "AETHER APO-11 structural evaluation API",
  "description": "Structural completeness only. This schema does not encode scientific truth, entailment, relevance, novelty, or calibration.",
  "oneOf": [
    { "$ref": "#/$defs/benchmarkCatalog" },
    { "$ref": "#/$defs/benchmarkDetail" },
    { "$ref": "#/$defs/snapshotRequest" },
    { "$ref": "#/$defs/snapshotReceipt" },
    { "$ref": "#/$defs/snapshotDocument" },
    { "$ref": "#/$defs/runRequest" },
    { "$ref": "#/$defs/reportEnvelope" },
    { "$ref": "#/$defs/reportList" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dimension": { "enum": ["literature_scope_inventory_integrity", "claim_source_locator_integrity", "evidence_provenance_field_integrity", "counterevidence_edge_integrity", "hypothesis_structure_completeness", "experiment_design_arithmetic_integrity", "uncertainty_field_wellformedness", "artifact_snapshot_replay_integrity"] },
    "outcome": { "enum": ["pass", "fail", "unavailable"] },
    "rulePin": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "rule_id", "version", "title", "scope", "cannot_establish", "empty_collection_policy"],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "rule_id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "pattern": "^[0-9]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 512 },
        "cannot_establish": { "type": "string", "minLength": 1, "maxLength": 512 },
        "empty_collection_policy": { "enum": ["fail_required", "unavailable_optional", "pass_only_if_explicitly_permitted"] }
      }
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "version", "scope", "evaluator_version", "dimension_rules", "limits", "excluded_metrics"],
      "properties": {
        "schema": { "const": "aether.quality-benchmark/1" },
        "id": { "const": "aether-research-quality-structural" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "scope": { "const": "structural_checks_only" },
        "evaluator_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dimension_rules": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/rulePin" } },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["request_bytes", "graph_depth", "graph_nodes", "graph_edges", "subjects", "artifact_bytes", "snapshot_bytes", "report_bytes", "report_list_bytes", "page_size"],
          "properties": {
            "request_bytes": { "const": 8192 }, "graph_depth": { "const": 3 },
            "graph_nodes": { "const": 64 }, "graph_edges": { "const": 192 },
            "subjects": { "const": 8 }, "artifact_bytes": { "const": 2097152 },
            "snapshot_bytes": { "const": 4194304 }, "report_bytes": { "const": 1048576 }, "report_list_bytes": { "const": 262144 },
            "page_size": { "const": 32 }
          }
        },
        "excluded_metrics": { "type": "array", "minItems": 5, "items": { "type": "string" } }
      }
    },
    "benchmarkCatalog": {
      "type": "object", "additionalProperties": false, "required": ["schema", "benchmarks"],
      "properties": { "schema": { "const": "aether.quality-benchmarks/1" }, "benchmarks": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["benchmark_sha256", "id", "version", "scope", "dimensions"], "properties": { "benchmark_sha256": { "$ref": "#/$defs/digest" }, "id": { "type": "string" }, "version": { "type": "string" }, "scope": { "const": "structural_checks_only" }, "dimensions": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/dimension" } } } } } }
    },
    "benchmarkDetail": {
      "type": "object", "additionalProperties": false, "required": ["schema", "benchmark_sha256", "benchmark"],
      "properties": { "schema": { "const": "aether.quality-benchmark-detail/1" }, "benchmark_sha256": { "$ref": "#/$defs/digest" }, "benchmark": { "$ref": "#/$defs/benchmark" } }
    },
    "artifactRef": {"type":"object","additionalProperties":false,"required":["kind","sha256"],"properties":{"kind":{"enum":["hypothesis_report","experiment_design_report"]},"sha256":{"$ref":"#/$defs/digest"}}},
    "subjectRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "artifact", "pointer"],
      "properties": { "kind": { "enum": ["hypothesis", "experiment_design"] }, "artifact": { "$ref": "#/$defs/artifactRef" }, "pointer": { "type": "string", "pattern": "^/", "maxLength": 512 } }
    },
    "snapshotRequest": {
      "type": "object", "additionalProperties": false, "required": ["schema", "graph_root_id", "graph_depth", "subjects", "generate_hypotheses", "generate_experiment_designs"],
      "properties": { "schema": { "const": "aether.quality-snapshot-request/1" }, "graph_root_id": { "$ref": "#/$defs/digest" }, "graph_depth": { "type": "integer", "minimum": 0, "maximum": 3 }, "subjects": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/subjectRef" } }, "generate_hypotheses": { "type": "boolean" }, "generate_experiment_designs": { "type": "boolean" } }
    },
    "snapshotReceipt": {
      "type": "object", "additionalProperties": false, "required": ["schema", "snapshot_sha256", "graph_root_id", "graph_sha256", "source_text_included", "source_replay"],
      "properties": { "schema": { "const": "aether.quality-snapshot-receipt/1" }, "snapshot_sha256": { "$ref": "#/$defs/digest" }, "graph_root_id": { "$ref": "#/$defs/digest" }, "graph_sha256": { "$ref": "#/$defs/digest" }, "source_text_included": { "const": false }, "source_replay": { "enum": ["available", "unavailable"] } }
    },
    "epistemicStatus": { "enum": ["proposed", "reported", "extracted", "inferred", "observed", "independently_verified", "unknown"] },
    "sourceIdentityStatus": { "enum": ["verified", "unverified", "not_applicable"] },
    "evidenceOrigin": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind","paper","paper_version","document","source_sha256","source_url","license","start_byte","end_byte","section"],"properties":{"kind":{"const":"passage"},"paper":{"type":["string","null"]},"paper_version":{"type":["string","null"]},"document":{"type":["string","null"]},"source_sha256":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"source_url":{"type":["string","null"]},"license":{"type":["string","null"]},"start_byte":{"type":["integer","null"],"minimum":0},"end_byte":{"type":["integer","null"],"minimum":0},"section":{"type":["string","null"]}}},
        {"type":"object","additionalProperties":false,"required":["kind","paper","snapshot_sha256"],"properties":{"kind":{"const":"metadata"},"paper":{"type":["string","null"]},"snapshot_sha256":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]}}},
        {"type":"object","additionalProperties":false,"required":["kind","artifact","artifact_sha256","pointer"],"properties":{"kind":{"const":"archive"},"artifact":{"type":["string","null"]},"artifact_sha256":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"pointer":{"type":["string","null"]}}},
        {"type":"object","additionalProperties":false,"required":["kind","campaign","protocol_sha256","record"],"properties":{"kind":{"const":"campaign"},"campaign":{"type":["string","null"]},"protocol_sha256":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"record":{"type":["string","null"]}}},
        {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"operator"}}}
      ]
    },
    "graphKind": { "enum": ["paper","claim","method","dataset","metric","experiment","model","evidence","limitation","hypothesis","research_question","campaign"] },
    "graphNodeFact": {
      "type":"object","additionalProperties":false,"required":["id","kind","revision_sha256","statement_sha256","statement_bytes","source","source_identity_status","epistemic_status"],
      "properties":{"id":{"$ref":"#/$defs/digest"},"kind":{"$ref":"#/$defs/graphKind"},"revision_sha256":{"$ref":"#/$defs/digest"},"statement_sha256":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"statement_bytes":{"type":"integer","minimum":0},"source":{"anyOf":[{"$ref":"#/$defs/evidenceOrigin"},{"type":"null"}]},"source_identity_status":{"anyOf":[{"$ref":"#/$defs/sourceIdentityStatus"},{"type":"null"}]},"epistemic_status":{"anyOf":[{"$ref":"#/$defs/epistemicStatus"},{"type":"null"}]}}
    },
    "graphEdgeFact": {"type":"object","additionalProperties":false,"required":["id","origin","target","relation"],"properties":{"id":{"$ref":"#/$defs/digest"},"origin":{"$ref":"#/$defs/digest"},"target":{"$ref":"#/$defs/digest"},"relation":{"enum":["supports","contradicts","other"]}}},
    "subjectFacts": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["kind","reference","proposition_present","support_count","counterevidence_count","alternative_count","assumption_count","limitation_count","falsification_present","metric_count","resources_present","uncertainty_grade","epistemic_status"],"properties":{"kind":{"const":"hypothesis"},"reference":{"$ref":"#/$defs/subjectRef"},"proposition_present":{"type":"boolean"},"support_count":{"type":"integer","minimum":0},"counterevidence_count":{"type":"integer","minimum":0},"alternative_count":{"type":"integer","minimum":0},"assumption_count":{"type":"integer","minimum":0},"limitation_count":{"type":"integer","minimum":0},"falsification_present":{"type":"boolean"},"metric_count":{"type":"integer","minimum":0},"resources_present":{"type":"boolean"},"uncertainty_grade":{"type":["integer","null"],"minimum":0,"maximum":255},"epistemic_status":{"anyOf":[{"$ref":"#/$defs/epistemicStatus"},{"type":"null"}]}}},
        {"type":"object","additionalProperties":false,"required":["kind","reference","independent_variable_count","dependent_variable_present","control_count","baseline_present","confounder_analysis_present","development_and_test_separated","sample_size_basis_present","statistical_plan_present","metric_count","falsification_present","termination_present","resource_cap_attempts","search_attempts","verification_attempts","oracle_attempts","reserve_attempts","resource_cap_wall_ms","declared_cpu_ms_ceiling"],"properties":{"kind":{"const":"experiment_design"},"reference":{"$ref":"#/$defs/subjectRef"},"independent_variable_count":{"type":"integer","minimum":0},"dependent_variable_present":{"type":"boolean"},"control_count":{"type":"integer","minimum":0},"baseline_present":{"type":"boolean"},"confounder_analysis_present":{"type":"boolean"},"development_and_test_separated":{"type":"boolean"},"sample_size_basis_present":{"type":"boolean"},"statistical_plan_present":{"type":"boolean"},"metric_count":{"type":"integer","minimum":0},"falsification_present":{"type":"boolean"},"termination_present":{"type":"boolean"},"resource_cap_attempts":{"type":"integer","minimum":0},"search_attempts":{"type":"integer","minimum":0},"verification_attempts":{"type":"integer","minimum":0},"oracle_attempts":{"type":"integer","minimum":0},"reserve_attempts":{"type":"integer","minimum":0},"resource_cap_wall_ms":{"type":"integer","minimum":0},"declared_cpu_ms_ceiling":{"type":"integer","minimum":0}}}
      ]
    },
    "structuralInput": {
      "type":"object","additionalProperties":false,"required":["graph_root_id","graph_sha256","graph_depth","graph_truncated","nodes","edges","subjects","snapshot_digest_verified","graph_digest_verified","source_replay_available"],
      "properties":{"graph_root_id":{"$ref":"#/$defs/digest"},"graph_sha256":{"$ref":"#/$defs/digest"},"graph_depth":{"type":"integer","minimum":0,"maximum":3},"graph_truncated":{"type":"boolean"},"nodes":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/graphNodeFact"}},"edges":{"type":"array","maxItems":192,"items":{"$ref":"#/$defs/graphEdgeFact"}},"subjects":{"type":"array","maxItems":8,"items":{"$ref":"#/$defs/subjectFacts"}},"snapshot_digest_verified":{"type":"boolean"},"graph_digest_verified":{"type":"boolean"},"source_replay_available":{"type":"boolean"}}
    },
    "snapshotDocument": {"type":"object","additionalProperties":false,"required":["schema","input","source_text_included","source_replay"],"properties":{"schema":{"const":"aether.quality-snapshot/1"},"input":{"$ref":"#/$defs/structuralInput"},"source_text_included":{"const":false},"source_replay":{"const":"unavailable"}}},
    "runRequest": {
      "type": "object", "additionalProperties": false, "required": ["schema", "benchmark_sha256", "snapshot_sha256"],
      "properties": { "schema": { "const": "aether.quality-run-request/1" }, "benchmark_sha256": { "$ref": "#/$defs/digest" }, "snapshot_sha256": { "$ref": "#/$defs/digest" } }
    },
    "structuralCheck": {
      "type": "object", "additionalProperties": false, "required": ["rule_id", "outcome", "reason_codes"],
      "properties": { "rule_id": { "type": "string" }, "outcome": { "$ref": "#/$defs/outcome" }, "reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } } }
    },
    "dimensionResult": {
      "type": "object", "additionalProperties": false, "required": ["dimension", "outcome", "checks"],
      "properties": { "dimension": { "$ref": "#/$defs/dimension" }, "outcome": { "$ref": "#/$defs/outcome" }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/structuralCheck" } } }
    },
    "dimensionRulePin": {
      "type": "object", "additionalProperties": false, "required": ["dimension", "rule_id", "version"],
      "properties": { "dimension": { "$ref": "#/$defs/dimension" }, "rule_id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^[0-9]+$" } }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "benchmark_sha256", "dimension_rule_pins", "evaluator", "snapshot_sha256", "graph_root_id", "graph_sha256", "execution_outcome", "dimensions", "semantic_assessment", "independent_scientific_validation", "source_replay", "limitations"],
      "properties": {
        "schema": { "const": "aether.quality-report/1" }, "benchmark_sha256": { "$ref": "#/$defs/digest" },
        "evaluator": { "type": "object", "additionalProperties": false, "required": ["version", "executable_sha256", "build_attestation"], "properties": { "version": { "type": "string" }, "executable_sha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "build_attestation": { "const": "not_provided" } } },
        "dimension_rule_pins": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/dimensionRulePin" } },
        "snapshot_sha256": { "$ref": "#/$defs/digest" }, "graph_root_id": { "$ref": "#/$defs/digest" }, "graph_sha256": { "$ref": "#/$defs/digest" },
        "execution_outcome": { "const": "completed" }, "dimensions": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/dimensionResult" } },
        "semantic_assessment": { "const": "not_evaluated" }, "independent_scientific_validation": { "const": "not_performed" }, "source_replay": { "enum": ["available", "unavailable"] }, "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "reportEnvelope": {
      "type": "object", "additionalProperties": false, "required": ["schema", "report_sha256", "sequence", "report"],
      "properties": { "schema": { "const": "aether.quality-report-envelope/1" }, "report_sha256": { "$ref": "#/$defs/digest" }, "sequence": { "type": "integer", "minimum": 1 }, "report": { "$ref": "#/$defs/report" } }
    },
    "dimensionSummary": {"type":"object","additionalProperties":false,"required":["dimension","outcome"],"properties":{"dimension":{"$ref":"#/$defs/dimension"},"outcome":{"$ref":"#/$defs/outcome"}}},
    "reportSummary": {"type":"object","additionalProperties":false,"required":["report_sha256","sequence","benchmark_sha256","snapshot_sha256","execution_outcome","dimensions"],"properties":{"report_sha256":{"$ref":"#/$defs/digest"},"sequence":{"type":"integer","minimum":1},"benchmark_sha256":{"$ref":"#/$defs/digest"},"snapshot_sha256":{"$ref":"#/$defs/digest"},"execution_outcome":{"const":"completed"},"dimensions":{"type":"array","minItems":8,"maxItems":8,"items":{"$ref":"#/$defs/dimensionSummary"}}}},
    "reportList": {
      "type": "object", "additionalProperties": false, "required": ["schema", "reports", "truncated", "next_before_sequence"],
      "properties": { "schema": { "const": "aether.quality-reports/1" }, "reports": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/reportSummary" } }, "truncated": { "type": "boolean" }, "next_before_sequence": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] } }
    }
  }
}
