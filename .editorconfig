root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,cff}]
indent_style = space
indent_size = 2

[docs/archive/**]
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
